{
  "route": {
    "rules": [
      {
        "domain_suffix": ["example.cn", "internal.example.com"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_cidr": ["10.0.0.0/8", "192.168.0.0/16"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "domain": ["www.example.com"],
        "action": "route",
        "outbound": "subscription"
      },
      {
        "domain_suffix": ["blocked.example"],
        "action": "reject"
      }
    ],
    "final": "subscription"
  }
}
