[Unit]
Description=Grouproxy Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grouproxy
Group=grouproxy
WorkingDirectory=/opt/grouproxy/src/backend
EnvironmentFile=/opt/grouproxy/etc/backend.env
ExecStart=/opt/grouproxy/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/grouproxy/etc /opt/grouproxy/var /opt/grouproxy/src

[Install]
WantedBy=multi-user.target
