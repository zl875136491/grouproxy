[Unit]
Description=Grouproxy Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/grouproxy/dashboard
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=80
ExecStart=/usr/bin/node /opt/grouproxy/dashboard/server.js
Restart=on-failure
RestartSec=5s
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/grouproxy/dashboard

[Install]
WantedBy=multi-user.target
