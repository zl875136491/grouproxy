[Unit]
Description=Grouproxy node monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grouproxy
Group=grouproxy
ExecStart=/opt/grouproxy/bin/grouproxy-monitor -config /opt/grouproxy/etc/monitor.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/grouproxy/etc /opt/grouproxy/var

[Install]
WantedBy=multi-user.target
