map $http_upgrade $grouproxy_connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 127.0.0.1:@@DASHBOARD_HTTP_PORT@@;
    server_name @@DASHBOARD_HOST@@;

    server_tokens off;
    client_max_body_size 10m;
    access_log /var/log/nginx/grouproxy-dashboard-access.log;

    location = /dashboard/backend-api {
        return 308 /dashboard/backend-api/;
    }

    location /dashboard/backend-api/ {
        proxy_pass http://127.0.0.1:@@BACKEND_PORT@@/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Prefix /dashboard;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $grouproxy_connection_upgrade;
        proxy_read_timeout 60s;
    }

    location /dashboard {
        proxy_pass http://127.0.0.1:@@FRONTEND_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Prefix /dashboard;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $grouproxy_connection_upgrade;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
