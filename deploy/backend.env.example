# Copy to /opt/grouproxy/etc/backend.env on the Beijing control-plane host.
# chmod 0640 and chown grouproxy:grouproxy. Never commit the filled file.

GROUPROXY_ENVIRONMENT=production
GROUPROXY_MONGODB_URL=mongodb://admin:<password>@127.0.0.1:27017/?authSource=admin
GROUPROXY_MONGODB_DATABASE=grouproxy
GROUPROXY_HOST=0.0.0.0
GROUPROXY_PORT=8000
GROUPROXY_BACKEND_PUBLIC_URL=http://127.0.0.1:8000
GROUPROXY_BUNDLE_HMAC_SECRET=<at-least-32-bytes>
GROUPROXY_ADMIN_USERNAME=zhangle
GROUPROXY_ADMIN_PASSWORD=<at-least-12-characters>
GROUPROXY_MANAGEMENT_TOKEN=<at-least-32-bytes>
GROUPROXY_ALLOW_INSECURE_AGENT_HTTP=true
GROUPROXY_SEED_DEFAULT_SITES=true
GROUPROXY_AUTH_SESSION_TTL_MINUTES=43200
GROUPROXY_CONNECTION_HISTORY_RETENTION_DAYS=90
GROUPROXY_GQUAN_DELIVERY_MODE=app
# GROUPROXY_GQUAN_APP_TOKEN=sat_<approved-app-token>
GROUPROXY_CORS_ALLOWED_ORIGINS=
GROUPROXY_BACKUP_DIRECTORY=/opt/grouproxy/var/backups
GROUPROXY_BACKUP_AUTO_ENABLED=false
