GROUPROXY_MONGODB_URL=mongodb://<user>:<password>@<host>:<port>/?authSource=admin
GROUPROXY_MONGODB_DATABASE=grouproxy
GROUPROXY_BUNDLE_HMAC_SECRET=replace-with-at-least-32-random-characters
GROUPROXY_ADMIN_USERNAME=admin
GROUPROXY_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
GROUPROXY_MANAGEMENT_TOKEN=replace-with-at-least-32-random-characters
GROUPROXY_ALLOW_INSECURE_AGENT_HTTP=true
GROUPROXY_PROXY_ACCESS_FQDN=proxy.1oa.com.cn
GROUPROXY_PROXY_ACCESS_PORT=80
GROUPROXY_PROXY_CREDENTIAL_SECRET=replace-with-a-stable-random-secret

# Backups are encrypted outside development/test. The directory must be owned
# by the service account, mode 0700, and backed by protected storage.
GROUPROXY_BACKUP_DIRECTORY=/var/lib/grouproxy/backups
GROUPROXY_BACKUP_ENCRYPTION_KEY=replace-with-a-stable-backup-encryption-key
# Automatic backup maintenance is opt-in. It retains scheduled backups only;
# manual snapshots are never deleted by the scheduler.
GROUPROXY_BACKUP_AUTO_ENABLED=false
GROUPROXY_BACKUP_AUTO_INTERVAL_SECONDS=86400
GROUPROXY_BACKUP_REHEARSAL_INTERVAL_SECONDS=604800
GROUPROXY_BACKUP_MAINTENANCE_INTERVAL_SECONDS=60
GROUPROXY_BACKUP_RETENTION_DAILY_DAYS=7
GROUPROXY_BACKUP_RETENTION_WEEKLY_WEEKS=4
GROUPROXY_BACKUP_RETENTION_MONTHLY_MONTHS=3

GROUPROXY_GQUAN_API_BASE_URL=https://one.1oa.com.cn/springboard/api/v1
GROUPROXY_GQUAN_APP_TOKEN=
GROUPROXY_GQUAN_DELIVERY_MODE=app
