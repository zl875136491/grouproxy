# MongoDB is an existing service. This Compose file intentionally does not
# declare or initialize a MongoDB container.
GROUPROXY_MONGODB_URL=mongodb://host.docker.internal:27017/?authSource=admin
GROUPROXY_MONGODB_DATABASE=grouproxy

GROUPROXY_BUNDLE_HMAC_SECRET=replace-with-at-least-32-random-characters
GROUPROXY_ADMIN_USERNAME=zhangle
GROUPROXY_ADMIN_PASSWORD=replace-with-at-least-12-characters
GROUPROXY_MANAGEMENT_TOKEN=replace-with-at-least-32-random-characters

GROUPROXY_ENVIRONMENT=production
GROUPROXY_ALLOW_INSECURE_AGENT_HTTP=true
GROUPROXY_SEED_DEFAULT_SITES=true
GROUPROXY_GQUAN_DELIVERY_MODE=app
# GROUPROXY_GQUAN_APP_TOKEN=sat_<approved-app-token>

GROUPROXY_FRONTEND_PORT=80
GROUPROXY_BACKEND_PORT=8000
